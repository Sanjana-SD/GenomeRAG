# GenomeRAG frontend (Vite). Only PUBLIC values belong here: everything prefixed VITE_ is embedded in the
# browser bundle. Never put API keys or Supabase secrets in a VITE_ variable.

# Base URL of the FastAPI backend, without a trailing slash.
#   Vercel (production): set to your Render service URL, e.g. https://genomerag-api.onrender.com
#   Local dev: leave unset; `npm run dev` proxies /api and /health to http://127.0.0.1:8000
# Changing it requires a rebuild/redeploy, because Vite inlines it at build time.
VITE_API_BASE_URL=
