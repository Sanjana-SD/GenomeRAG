# ---------------------------------------------------------------- Qdrant Cloud
# cloud.qdrant.io -> your cluster ("genomerag") -> API Keys
QDRANT_URL=https://d1ad50c4-4439-432a-b300-5471be07be4b.europe-west6-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# ---------------------------------------------------------------- Groq
# console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Chat model id. `scripts/verify_setup.py groq` lists the models your key can use.
GROQ_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------- Supabase
# Project Settings -> API Keys. Use the SECRET key (sb_secret_... or the legacy
# service_role JWT). The publishable/anon key cannot write: the schema enables
# Row Level Security. This key stays on the server and is never sent to the UI.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_secret_key_here
# Optional: if set, takes precedence over SUPABASE_KEY.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Web
# Comma-separated browser origins allowed to call the API directly.
# Not needed when using the Vite dev proxy or the FastAPI-served build.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
