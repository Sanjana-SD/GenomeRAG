# GenomeRAG backend configuration. Copy to backend/.env (or the repo root .env) for local runs.
# On Render, set these in the service's Environment tab instead; no .env file is deployed.

# ---------------------------------------------------------------- Qdrant Cloud
# cloud.qdrant.io -> your cluster -> API Keys
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# ---------------------------------------------------------------- Groq
# console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Chat model id. `python scripts/verify_setup.py groq` lists the models your key can use.
GROQ_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------- Storage
# Where runs, benchmarks and chat sessions are saved:
#   local    - a JSON file under backend/data (or GENOMERAG_DATA_DIR); Supabase is never contacted
#   supabase - Supabase only (requires scripts/schema.sql and the secret key)
#   auto     - (default if unset) Supabase when usable, otherwise the local file
STORAGE_BACKEND=local
# Optional: directory for the local JSON file (e.g. a Render persistent disk mounted at /var/data)
# GENOMERAG_DATA_DIR=/var/data

# ---------------------------------------------------------------- Supabase
# Only needed when STORAGE_BACKEND is supabase or auto.
# Project Settings -> API Keys: use the SECRET key (sb_secret_... or legacy service_role). Server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_secret_key_here
# Optional: if set, takes precedence over SUPABASE_KEY.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- CORS
# Comma-separated browser origins allowed to call this API (no trailing slash, no "*").
# Default if unset: http://localhost:5173, http://127.0.0.1:5173 and https://genome-rag-tcvs.vercel.app
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://genome-rag-tcvs.vercel.app
# Optional: regex for Vercel preview deployments, e.g. https://genome-rag-.*-your-team\.vercel\.app
# FRONTEND_ORIGIN_REGEX=

# Optional: DEBUG, INFO (default), WARNING
# LOG_LEVEL=INFO
